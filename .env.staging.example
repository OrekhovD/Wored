# Staging env — copy to .env.staging and fill real values before booting
# `docker compose -p woredstg -f docker-compose.staging.yml up -d`.
#
# NEVER reuse production values here. The point of the staging stack is that
# a leaked staging secret cannot reach a real Telegram bot or production
# session cookie.

# WebUI admin login (used by `admin` user in staging browser QA).
WEBUI_ADMIN_PASSWORD=change-me-staging-only

# Session signing secret — generate a fresh one per staging boot:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBUI_SESSION_SECRET=replace-with-fresh-token-urlsafe-32

# Cookie / CSRF flags — staging runs on plain http, no TLS.
WEBUI_COOKIE_SECURE=false
WEBUI_COOKIE_SAME_SITE=lax

# Optional: allow anonymous demo access (leave commented for stricter QA).
# WEBUI_ALLOW_ANONYMOUS=true

# These are read by webui/app.py at lifespan start; leaving them unset keeps
# the staging stack free of any real AI provider calls.
# OLLAMA_CLOUD_API_KEY=
# NVIDIA_MISTRAL_NEMOTRON_API_KEY=
# NVIDIA_MINIMAX_M3_API_KEY=
# OPENROUTER_API_KEY=

# Chatbot / Telegram are NOT booted in the staging compose. If you add them
# later, use a throwaway bot token registered specifically for staging.
