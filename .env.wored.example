# WORED Bot (.env.wored) — separate Telegram bot instance
# Copy to .env.wored and replace placeholder values.
# IMPORTANT: WEBUI_INTERNAL_TOKEN must match the value in .env

# WORED Bot Telegram
TELEGRAM_BOT_TOKEN=replace_with_wored_bot_token
TELEGRAM_WORED_TOKEN=replace_with_wored_bot_token
TELEGRAM_ADMIN_IDS=

# AI providers — must match .env
OLLAMA_CLOUD_API_KEY=replace_with_ollama_cloud_api_key
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1

# Shared auth token — MUST be identical in .env and .env.wored
WEBUI_INTERNAL_TOKEN=replace_with_token_min_32_chars_same_in_both_env_files

# WebUI connection
WEBUI_PUBLIC_BASE_URL=http://localhost:8080

# Storage (shared with main .env)
DATABASE_URL=postgresql+asyncpg://bot:change_me_strong_password@postgres:5432/trading
REDIS_URL=redis://redis:6379/0