{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "WORED: Boot (bonsai + docker)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\scripts\\wored_boot.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false,
                "focus": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "WORED: Bonsai status",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "try { $r = Invoke-WebRequest -Uri 'http://127.0.0.1:8088/api/ps' -TimeoutSec 5 -UseBasicParsing; $r.Content } catch { Write-Host 'bonsai server DOWN on :8088' }"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "WORED: Docker status",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "ps"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}