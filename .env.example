# Root runtime configuration for D:\WORED
# Copy this file to .env and replace placeholder values.

# Telegram
TELEGRAM_TOKEN=1234567890:replace_with_bot_token
TELEGRAM_ADMIN_ID=123456789

# AI providers — primary: Ollama Cloud
# webui Prediction Lab uses the same keys.
# If a key is empty, the corresponding provider stays offline.
OLLAMA_CLOUD_API_KEY=replace_with_ollama_cloud_api_key
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1

OLLAMA_WORKER_MODEL=deepseek-v4-flash
OLLAMA_ANALYST_MODEL=deepseek-v4-pro
OLLAMA_PREMIUM_MODEL=glm-5.2
OLLAMA_ANALYST_FALLBACK_MODEL=deepseek-v4-pro
OLLAMA_PREMIUM_FALLBACK_MODEL=kimi-k2.6
OLLAMA_ORACLE_MODEL=minimax-m3
OLLAMA_ORACLE_FALLBACK_MODEL=glm-5.1

# AI providers — cheap utility: TokenRouter / Kimi K3 Free (optional)
TOKENROUTER_API_KEY=

# AI providers — fallback: NVIDIA NIM (optional)
NVIDIA_MISTRAL_NEMOTRON_API_KEY=
NVIDIA_MINIMAX_M3_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PROBE_TIMEOUT=45

# AI providers — fallback: OpenRouter (optional, no Qwen)
OPENROUTER_API_KEY=

# Market runtime
WATCHLIST=btcusdt,ethusdt
ALERT_SPIKE_THRESHOLD=3.0
LOG_LEVEL=INFO
WEBUI_PORT=8080
HTX_REST_URL=https://api.huobi.pro
# Auth — required for release; generate strong values via secrets.token_urlsafe()
WEBUI_AUTH_ENABLED=true
WEBUI_ADMIN_USERNAME=admin
# Run `python -c "import secrets; print(secrets.token_urlsafe(24))"` to generate
WEBUI_ADMIN_PASSWORD=replace_with_generated_password_min_16_chars
WEBUI_SESSION_SECRET=replace_with_generated_secret_min_32_chars
WEBUI_INTERNAL_TOKEN=replace_with_token_min_32_chars_same_in_both_env_files
# JSON array of two Telegram bot tokens: ["<main_bot_token>", "<wored_bot_token>"]
WEBUI_TELEGRAM_BOT_TOKENS=["replace_with_main_bot_token", "replace_with_wored_bot_token"]
# Comma-separated Telegram admin IDs; empty list = deny Telegram-admin
TELEGRAM_ADMIN_IDS=
# HTTPS origin of the tunnel (no path/query); http://localhost:8080 for local dev
WEBUI_PUBLIC_BASE_URL=http://localhost:8080
# Set to true when HTTPS is working; false for local HTTP dev
WEBUI_COOKIE_SECURE=false
WEBUI_PORT=8080
WEBUI_INTERNAL_URL=http://webui:8000

# Storage
POSTGRES_USER=bot
# Run `python scripts/generate_secrets.py` to generate secure password
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=trading
DATABASE_URL=postgresql+asyncpg://bot:change_me_strong_password@postgres:5432/trading
REDIS_URL=redis://redis:6379/0

# LLM Provider Gateway
LLM_ROUTING_MODE=balanced
LLM_PAID_ENABLED=false
LLM_REGISTRY_PATH=/config/provider_registry.json
SIM_ALLOWED_SYMBOLS=btcusdt
PERPLEXITY_API_KEY=
DEFAULT_AI_MODEL=
BRIEFING_HOUR_UTC=1
TIMEZONE_OFFSET_HOURS=7
HTX_ACCESS_KEY=
HTX_SECRET_KEY=
HTX_PASSPHRASE=

# Hermes Agent — Telegram Gateway (отдельный бот для управления проектом)
# Создай отдельный бот через @BotFather и впиши токен сюда.
HERMES_TELEGRAM_TOKEN=
HERMES_ADMIN_TELEGRAM_ID=
HERMES_CHATBOT_GATEWAY_ENABLED=false
HERMES_CLI=hermes
HERMES_WORKDIR=/mnt/d/WORED
